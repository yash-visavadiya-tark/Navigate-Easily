{
  "manifest_version": 3,
  "name": "Navigate Easily",
  "version": "1.1.0",
  "description": "Ctrl+K palette to search and jump to any page of a web app by title or path, with deep route discovery for Angular apps.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/js-tokens.js", "route-extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
